# Default API key authentication (qBittorrent 5.2+)
QBITTORRENT_URL=http://localhost:8080
# Uncomment and replace the placeholder to use an API key:
# QBITTORRENT_API_KEY=qbt_REPLACE_WITH_GENERATED_KEY

# Used only with --login; overrides API key and SID authentication.
# QBITTORRENT_USERNAME=your_webui_username
# QBITTORRENT_PASSWORD="your_webui_password"

# Legacy pre-existing session (used only without an API key or --login):
# QBITTORRENT_SID=your_session_cookie_value
